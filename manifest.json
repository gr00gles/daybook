{
  "manifest_version": 3,
  "name": "Daybook",
  "version": "2.41.0",
  "description": "Your new tab: your calendar, unread Gmail and Outlook, weather, headlines and search.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "topSites",
    "favicon",
    "geolocation",
    "identity",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://accounts.google.com/*",
    "https://calendar.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.office.com/*",
    "https://news.google.com/*",
    "https://api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://photon.komoot.io/*",
    "https://www.youtube.com/*",
    "https://api.weather.gov/*",
    "https://routing.openstreetmap.de/*",
    "https://api.tomtom.com/*",
    "https://finnhub.io/*",
    "https://date.nager.at/*",
    "https://en.wikipedia.org/*",
    "https://site.api.espn.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://app.ticketmaster.com/*",
    "https://statejobs.ny.gov/*",
    "https://*.ups.com/*",
    "https://*.usps.com/*",
    "https://*.fedex.com/*",
    "https://*.dhl.com/*",
    "https://track.amazon.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ups.com/track*",
        "https://tools.usps.com/go/TrackConfirmAction*",
        "https://www.fedex.com/fedextrack/*",
        "https://www.dhl.com/*tracking*",
        "https://track.amazon.com/tracking/*"
      ],
      "js": [
        "js/track-page.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/mail/u/*"
      ],
      "js": [
        "js/gmail-page.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "1049980658331-muunpqnbltmqnatckcqogsmpuul3dqj2.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
